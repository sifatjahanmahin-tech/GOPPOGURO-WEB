---
import { site, footer } from '../data/site';
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" aria-label={`${site.name} — home`}>
          <img src="/brand/logo.jpeg" alt={`${site.name} logo`} class="footer__logo" width="48" height="48" />
        </a>
        <p class="footer__tagline">{footer.tagline}</p>
        <p class="footer__description">{footer.description}</p>
        <div class="footer__social">
          <a
            href={site.social.facebook}
            target="_blank"
            rel="noopener noreferrer"
            class="footer__social-link"
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <h4 class="footer__nav-title">Navigate</h4>
        <ul class="footer__nav-list">
          {footer.navigate.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer__nav" aria-label="Explore">
        <h4 class="footer__nav-title">Explore</h4>
        <p class="footer__nav-subheader">Programme</p>
        <ul class="footer__nav-list">
          {footer.programme.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
        <p class="footer__nav-subheader" style="margin-top: var(--space-3);">Project</p>
        <ul class="footer__nav-list">
          {footer.project.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer__newsletter">
        <h4 class="footer__nav-title">Stay Connected</h4>
        <p>Get updates on new products and impact stories.</p>
        <form class="footer__form" name="newsletter" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="newsletter" />
          <p hidden>
            <label>Do not fill this out if you are human: <input name="bot-field" /></label>
          </p>
          <input type="email" name="email" placeholder="Your email" class="footer__input" required aria-label="Your email" />
          <button type="submit" class="btn btn--primary btn--small">Subscribe</button>
        </form>
      </div>
    </div>

    <div class="footer__sdg">
      {footer.sdgs.map((sdg) => <span class="footer__sdg-badge">{sdg}</span>)}
    </div>

    <div class="footer__bottom">
      <p>{footer.legal}</p>
      <p>{footer.promise}</p>
    </div>
  </div>
</footer>
